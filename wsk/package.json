{
  "name": "@seance/wsk",
  "version": "0.1.0",
  "description": "Local-first work-item ledger with curated GitHub publishing, enforced conventions, and epics as stacked PRs.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "wsk": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli/main.d.ts",
      "default": "./dist/cli/main.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^22.10.2"
  }
}
